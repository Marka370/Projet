# Copie ce fichier en « .env » (ne le publie JAMAIS sur GitHub).
# Token du bot : Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=
# Identifiant du serveur (optionnel si le bot n'est que sur ton serveur,
# mais recommandé : les commandes slash apparaissent instantanément)
GUILD_ID=
# Dossier où le bot garde ses données (avertissements)
DATA_DIR=data
